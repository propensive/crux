//| mill-version: 1.1.5
//| mill-jvm-version: temurin:25

package build

import mill.*
import scalalib.*
import publish.*

object settings:
  // A plugin's TASTy is read by the compiler its host compiles build definitions with, and a
  // compiler reads TASTy no newer than its own minor version. Mill 1.1.5 is built with Scala
  // 3.8.2 and sbt 2.0.12 with 3.8.4 — both TASTy 28.8 — so every module is built with 3.8.4.
  val scalaVersion = "3.8.4"
  val millVersion = "1.1.5"
  val sbtVersion = "2.0.12"
  val utestVersion = "0.8.9"

  // This build's version. A release's version is declared once, by its tag: the release
  // (release.sh in propensive/.github) and a snapshot (snapshot.sh) both name it in
  // `CRUX_RELEASE_VERSION`. Any other build is the version after the latest release reachable
  // from HEAD — its patch version plus one — or `0.0.1` where no release tag is reachable, as in
  // CI's shallow checkout. Called from `Task.Input`s, so the environment and the tags are read on
  // every invocation.
  def version(env: Map[String, String]): String =
    env.get("CRUX_RELEASE_VERSION").filter(_.nonEmpty).getOrElse(nextVersion)

  def nextVersion: String =
    val root = mill.api.BuildCtx.workspaceRoot

    val latest: Option[String] =
      scala.util.Try:
        os.proc("git", "describe", "--tags", "--abbrev=0", "--match", "[0-9]*.[0-9]*.[0-9]*")
        . call(cwd = root, stderr = os.Pipe).out.text().trim
      . toOption

    def numeric(part: String): Boolean = part.nonEmpty && part.forall(_.isDigit)

    latest.collect:
      case s"$major.$minor.$patch" if Seq(major, minor, patch).forall(numeric) =>
        s"$major.$minor.${patch.toInt + 1}"
    . getOrElse("0.0.1")

trait Publishing extends ScalaModule, SonatypeCentralPublishModule:
  // A `Task.Input` reading `Task.env`, not a plain value: `CRUX_RELEASE_VERSION` is how a release
  // and `make snapshot` drive the version through a Mill daemon that is already running — the
  // daemon freezes `sys.env` at its own start, while `Task.env` is the environment of each
  // `./mill` invocation.
  def publishVersion = Task.Input(settings.version(Task.env))

  // Published without the `_3` suffix, like every other propensive artifact.
  def artifactSuffix = Task("")

  def scalacOptions = Seq("-deprecation", "-feature")

  def pomSettings = Task(PomSettings(
    description = "Build-tool plugins for consuming libraries published on GitHub Releases",
    organization = "dev.propensive",
    url = "https://github.com/propensive/crux",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("propensive", "crux"),
    developers = Seq(Developer("propensive", "Jon Pretty", "https://github.com/propensive"))))

  override def docJar = Task:
    val jar = Task.dest / "empty.jar"
    val zos = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(jar.toIO))
    zos.close()
    PathRef(jar)

// What both plugins share, and what a release pipeline needs to emit the crux layout: pins, the
// pin-file format, the GitHub Releases repository patterns, and the ivy.xml filter. No build-tool
// dependency, and no Soundness dependency, so that crux can be consumed before anything else is.
object core extends Publishing:
  def scalaVersion = settings.scalaVersion
  def artifactName = "crux-core"

  object test extends ScalaTests, TestModule.Utest:
    def utestVersion = settings.utestVersion

// The Mill plugin, `dev.propensive:crux-mill`. Mill is on the classpath of any build that loads
// it, hence `compileMvnDeps`.
object millPlugin extends Publishing:
  def scalaVersion = settings.scalaVersion
  def artifactName = "crux-mill"
  def moduleDeps = Seq(core)
  def compileMvnDeps = Seq(mvn"com.lihaoyi:mill-libs_3:${settings.millVersion}")

// The sbt plugin for sbt 2, `addSbtPlugin("dev.propensive" % "sbt-crux" % version)`: sbt asks for
// an sbt 2 plugin as `<name>_sbt2_3`, so that is the artifactId (as on Maven Central, e.g.
// `sbt-mima-plugin_sbt2_3`). The `sbt/sbt.autoplugins` resource is how sbt discovers an
// AutoPlugin in a jar.
object sbtPlugin extends Publishing:
  def scalaVersion = settings.scalaVersion
  def artifactName = "sbt-crux"
  override def artifactSuffix = Task("_sbt2_3")
  def moduleDeps = Seq(core)
  def compileMvnDeps = Seq(mvn"org.scala-sbt:sbt:${settings.sbtVersion}")

  override def resources = Task:
    os.write.over(Task.dest / "sbt" / "sbt.autoplugins", "crux.CruxPlugin\n", createFolders = true)
    super.resources() ++ Seq(PathRef(Task.dest))

// The release pipeline's view of the build, driven by release.sh in propensive/.github. A tagged
// version becomes one GitHub release whose assets are, per module, `<artifactId>-<version>.jar`
// (self-describing: its POM and ivy.xml under `META-INF/maven/<group>/<artifactId>/`) and
// `<artifactId>-<version>.ivy.xml`, the metadata Coursier reads when the release is used as an
// Ivy-pattern repository — the crux layout, which crux's own plugins consume.
object release extends Module:
  def modules: Seq[PublishModule] = Seq(core, millPlugin, sbtPlugin)

  private def withDescriptors(source: os.Path, target: os.Path, entries: Seq[(String, os.Path)])
  :   Unit =
    val input = new java.util.zip.ZipFile(source.toIO)
    val output = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(target.toIO))
    try
      val existing = input.entries()
      while existing.hasMoreElements do
        val entry = existing.nextElement()
        output.putNextEntry(new java.util.zip.ZipEntry(entry.getName))
        if !entry.isDirectory then input.getInputStream(entry).transferTo(output)
        output.closeEntry()

      for (name, file) <- entries do
        output.putNextEntry(new java.util.zip.ZipEntry(name))
        output.write(os.read.bytes(file))
        output.closeEntry()
    finally
      output.close()
      input.close()

  // The published ivy.xml without its sources and javadoc publications (the same filter as
  // `crux.Descriptor.strip`, which this build cannot call before crux is built). Mill declares
  // them in the `compile` configuration, and the crux artifact pattern names the main jar for any
  // publication without a classifier, so left in place they would resolve to the jar itself.
  private def stripDescriptor(ivy: String): String =
    val artifact = """<artifact\b[^>]*?(?:/>|>\s*</artifact>)""".r
    val lines = artifact.replaceAllIn(ivy, found =>
      if found.matched.contains("classifier=") || found.matched.matches("""(?s).*\btype="(src|doc)".*""")
      then "" else java.util.regex.Matcher.quoteReplacement(found.matched))
    lines.linesIterator.filter(_.trim.nonEmpty).mkString("", "\n", "\n")

  def stage: T[Seq[PathRef]] = Task:
    val jars: Seq[(PathRef, String, String, String, PathRef, PathRef)] =
      Task.traverse(modules)(module =>
        Task.Anon((module.jar(), module.pomSettings().organization, module.artifactId(),
                   module.publishVersion(), module.pom(), module.ivy())))()

    jars.flatMap: (jar, group, artifactId, version, pom, ivy) =>
      val target = Task.dest / s"$artifactId-$version.jar"
      val prefix = s"META-INF/maven/$group/$artifactId"
      val descriptors = Seq(s"$prefix/pom.xml" -> pom.path, s"$prefix/ivy.xml" -> ivy.path)
      withDescriptors(jar.path, target, descriptors)
      val metadata = Task.dest / s"$artifactId-$version.ivy.xml"
      os.write.over(metadata, stripDescriptor(os.read(ivy.path)))
      Seq(PathRef(target), PathRef(metadata))
